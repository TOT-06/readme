<h1>投稿一覧</h1>
<div class="article-actions">
<%= link_to "新規投稿", new_article_path, class: "new-button" %>
</div>
<% if @articles.any? %>
<table class="article-table">
<thead>
<tr>
<th>タイトル</th>
<th>投稿日</th>
</tr>
</thead>
<tbody>
<% @articles.each do |article| %>
<tr>
<td>
<%= link_to article.title, article_path(article) %>
</td>
<td>
<%= article.created_at.strftime("%Y/%m/%d %H:%M") %>
</td>
</tr>
<% end %>
</tbody>
</table>
<% else %>
<p>まだ投稿がありません。</p>
<% end %>
 